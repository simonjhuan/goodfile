{
  "name": "goodfile",
  "version": "3.0.0",
  "description": "GoodFile — Fast local file transfer. No cloud. No limits.",
  "author": "GoodFile",
  "main": "desktop/main.js",
  "scripts": {
    "test": "node test/qr-token-contract.test.js && node test/diagnostics.test.js && node test/assets-in-sync.test.js",
    "sync": "node scripts/sync-web-assets.js",
    "start": "electron desktop",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.goodfile.app",
    "productName": "GoodFile",
    "copyright": "Copyright © 2026 GoodFile",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GoodFile"
    }
  },
  "dependencies": {
    "@byteowls/capacitor-filesharer": "^7.0.0",
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-community/file-opener": "^8.0.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1"
  }
}
