{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goodfile-pair",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING_ROOM", "class_name": "PairingRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PairingRoom"] }
  ],
  "ratelimits": [
    {
      "name": "CODE_ATTEMPTS",
      "namespace_id": "4827",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
