{
  "name": "goodfile",
  "version": "2.0.0",
  "description": "GOODFILE — Local file transfer app",
  "main": "main.js",
  "author": "goodfile",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.goodfile.app",
    "productName": "GOODFILE",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GOODFILE"
    }
  }
}
