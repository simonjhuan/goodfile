# Copy this file to "keystore.properties" (same folder) and fill in your real values.
# Do NOT commit keystore.properties or your .jks file to git.
#
# storeFile: path to your keystore. Relative paths are resolved from the android/ folder.
#   e.g. storeFile=../release.jks   or an absolute path like  storeFile=D:/keys/goodfile.jks
storeFile=PATH/TO/your-release-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
